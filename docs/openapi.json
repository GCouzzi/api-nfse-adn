                }
              }
            }
          }
        }
      }
    },
    "/api/notas/{chaveAcesso}/zip": {
      "get": {
        "summary": "Download do pacote ZIP da NFS-e com todos os seus eventos",
        "tags": ["Downloads"],
        "parameters": [
          {
            "name": "chaveAcesso",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string"
            }
          },
          {
            "name": "empresaId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Empresa cadastrada. Informe empresaId ou o CNPJ cadastrado para acessar suas notas."
          },
          {
            "name": "cnpj",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "CNPJ da empresa cadastrada. Obrigatório quando empresaId não é informado."
          }
        ],
        "responses": {
          "200": {
            "description": "Arquivo ZIP contendo a NFS-e e seus eventos",
