          },
          {
            "name": "prestador",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Parte do CNPJ, com ou sem máscara, ou nome do prestador"
          },
          {
            "name": "tomador",
            "in": "query",
