              "application/xml": {
                "schema": {
                  "type": "string"
                }
              }
            }
          }
        },
        "description": " O contexto da empresa cadastrada é obrigatório."
      }
    },
    "/api/empresas": {
      "get": {
        "tags": ["Empresas"],
        "summary": "Lista empresas cadastradas e metadados do certificado",
        "responses": {
          "200": {
            "description": "Empresas cadastradas",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Empresas"],
        "summary": "Cadastra uma empresa",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nome", "cnpj"],
                "properties": {
                  "nome": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "cnpj": {
                    "type": "string",
                    "example": "12345678000195"
                  },
                  "ativa": {
                    "type": "boolean",
                    "default": true
                  },
                  "certificado_id": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Empresa cadastrada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "409": {
            "description": "CNPJ já cadastrado"
          }
        }
      }
    },
    "/api/empresas/{id}": {
      "put": {
        "tags": ["Empresas"],
        "summary": "Edita empresa e certificado vinculado; o CNPJ é imutável",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["nome", "cnpj"],
                "properties": {
                  "nome": {
                    "type": "string",
                    "maxLength": 200
                  },
                  "cnpj": {
                    "type": "string",
                    "example": "12345678000195"
                  },
                  "ativa": {
                    "type": "boolean",
                    "default": true
                  },
                  "certificado_id": {
                    "type": "string",
                    "format": "uuid",
                    "nullable": true
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Empresa atualizada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/certificados/arquivos": {
      "get": {
        "tags": ["Certificados"],
        "summary": "Lista arquivos A1 da pasta permitida",
        "responses": {
          "200": {
            "description": "Arquivos disponíveis",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/certificados": {
      "get": {
        "tags": ["Certificados"],
        "summary": "Lista certificados sem senha ou conteúdo privado",
        "responses": {
          "200": {
            "description": "Metadados dos certificados",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      },
      "post": {
        "tags": ["Certificados"],
        "summary": "Valida o certificado e armazena a senha criptografada",
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["arquivo", "senha"],
                "properties": {
                  "arquivo": {
                    "type": "string",
                    "example": "empresa.pfx"
                  },
                  "senha": {
                    "type": "string",
                    "format": "password",
                    "writeOnly": true,
                    "maxLength": 1000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "201": {
            "description": "Certificado validado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          },
          "400": {
            "description": "Arquivo, validade ou senha inválida"
          },
          "503": {
            "description": "Chave de criptografia não configurada"
          }
        }
      }
    },
    "/api/certificados/upload": {
      "post": {
        "tags": ["Certificados"],
        "summary": "Envia, valida e cadastra um certificado A1",
        "description": "Recebe um .pfx ou .p12 de até 10 MB e sua senha. Salva em CERTIFICATES_DIR com nome gerado pelo servidor. O arquivo só é gravado após validação. Exige a autenticação da API quando configurada.",
        "requestBody": {
          "$ref": "#/components/requestBodies/CertificateUpload"
        },
        "responses": {
          "201": { "$ref": "#/components/responses/CertificateSaved" },
          "400": { "description": "Arquivo, senha ou formulário inválido" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "413": { "description": "Arquivo maior que 10 MB" },
          "415": { "description": "Utilize multipart/form-data" },
          "503": {
            "description": "Chave de criptografia ou armazenamento indisponível"
          }
        }
      }
    },
    "/api/certificados/{id}/upload": {
      "put": {
        "tags": ["Certificados"],
        "summary": "Substitui o certificado por um arquivo enviado",
        "description": "Mantém o ID e os vínculos com empresas. O arquivo anterior é preservado; o novo arquivo recebe nome exclusivo. Usa os mesmos limites e validações do cadastro por upload.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": { "type": "string", "format": "uuid" }
          }
        ],
        "requestBody": {
          "$ref": "#/components/requestBodies/CertificateUpload"
        },
        "responses": {
          "200": { "$ref": "#/components/responses/CertificateSaved" },
          "400": { "description": "Arquivo, senha ou formulário inválido" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Certificado não encontrado" },
          "413": { "description": "Arquivo maior que 10 MB" },
          "415": { "description": "Utilize multipart/form-data" },
          "503": {
            "description": "Chave de criptografia ou armazenamento indisponível"
          }
        }
      }
    },
    "/api/certificados/{id}": {
      "put": {
        "tags": ["Certificados"],
        "summary": "Substitui ou revalida um certificado",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "required": ["arquivo", "senha"],
                "properties": {
                  "arquivo": {
                    "type": "string",
                    "example": "empresa.pfx"
                  },
                  "senha": {
                    "type": "string",
                    "format": "password",
                    "writeOnly": true,
                    "maxLength": 1000
                  }
                }
              }
            }
          }
        },
        "responses": {
          "200": {
            "description": "Certificado atualizado",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "additionalProperties": true
                }
              }
            }
          }
        }
      }
    },
    "/api/notas/{chaveAcesso}/pdf": {
      "get": {
        "tags": ["PDFs"],
        "summary": "Gera DANFSe em memória a partir do XML e status consolidado",
        "parameters": [
          {
            "name": "chaveAcesso",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "pattern": "^\\d{50}$"
            }
          },
          {
            "name": "empresaId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Empresa cadastrada. Informe empresaId ou o CNPJ cadastrado para acessar suas notas."
          },
          {
            "name": "cnpj",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            },
            "description": "Alternativa ao empresaId."
          }
        ],
        "responses": {
          "200": {
            "description": "DANFSe da nota",
            "content": {
              "application/pdf": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "404": {
            "description": "Nota sem vínculo com a empresa ou XML ausente"
          },
          "502": {
            "description": "Falha no renderizador"
          },
          "503": {
            "description": "Renderizador não configurado"
          }
        }
      }
    },
    "/api/notas/pdf/exportacoes": {
      "get": {
        "tags": ["PDFs"],
        "summary": "Lista as últimas 20 exportações da empresa",
        "description": "Exige empresaId ou cnpj. Retorna somente exportações da empresa no ambiente atual, em ordem decrescente de criação, incluindo falhas e expiradas. Permite recuperar downloads após fechar a página.",
        "parameters": [
          {
            "name": "empresaId",
            "in": "query",
            "schema": { "type": "string", "format": "uuid" }
          },
          { "name": "cnpj", "in": "query", "schema": { "type": "string" } }
        ],
        "responses": {
          "200": {
            "description": "Exportações recentes, com progresso e prazo de disponibilidade",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": { "type": "boolean" },
                    "data": {
                      "type": "array",
                      "maxItems": 20,
                      "items": { "$ref": "#/components/schemas/PdfExport" }
                    }
                  }
                }
              }
            }
          },
          "400": { "description": "Contexto da empresa ausente ou inválido" },
          "401": { "$ref": "#/components/responses/Unauthorized" },
          "404": { "description": "Empresa não cadastrada" }
        }
      },
      "post": {
        "tags": ["PDFs"],
        "summary": "Exporta todos os PDFs da empresa ou de uma competência em segundo plano",
        "description": "Um PDF por nota em ZIP. Ignora paginação e os demais filtros da listagem. Exige empresaId ou cnpj.",
        "parameters": [
          {
            "name": "empresaId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Empresa cadastrada. Informe empresaId ou o CNPJ cadastrado para acessar suas notas."
          },
          {
            "name": "cnpj",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "requestBody": {
          "required": true,
          "content": {
            "application/json": {
              "schema": {
                "type": "object",
                "properties": {
                  "competencia": {
                    "type": "string",
                    "pattern": "^\\d{4}-(0[1-9]|1[0-2])$"
                  }
                }
              }
            }
          }
        },
        "responses": {
          "202": {
            "description": "Exportação enfileirada",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "empresa_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "QUEUED",
                            "PROCESSING",
                            "COMPLETED",
                            "PARTIAL",
                            "FAILED",
                            "EXPIRED"
                          ]
                        },
                        "total": {
                          "type": "integer"
                        },
                        "processadas": {
                          "type": "integer"
                        },
                        "falhas": {
                          "type": "integer"
                        },
                        "erro": {
                          "type": "string",
                          "nullable": true
                        },
                        "expires_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          },
          "404": {
            "description": "Nenhuma nota para exportar"
          }
        }
      }
    },
    "/api/notas/pdf/exportacoes/{id}": {
      "get": {
        "tags": ["PDFs"],
        "summary": "Consulta progresso e resultado da exportação",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "empresaId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Empresa cadastrada. Informe empresaId ou o CNPJ cadastrado para acessar suas notas."
          },
          {
            "name": "cnpj",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "Exportação",
            "content": {
              "application/json": {
                "schema": {
                  "type": "object",
                  "properties": {
                    "success": {
                      "type": "boolean"
                    },
                    "data": {
                      "type": "object",
                      "properties": {
                        "id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "empresa_id": {
                          "type": "string",
                          "format": "uuid"
                        },
                        "status": {
                          "type": "string",
                          "enum": [
                            "QUEUED",
                            "PROCESSING",
                            "COMPLETED",
                            "PARTIAL",
                            "FAILED",
                            "EXPIRED"
                          ]
                        },
                        "total": {
                          "type": "integer"
                        },
                        "processadas": {
                          "type": "integer"
                        },
                        "falhas": {
                          "type": "integer"
                        },
                        "erro": {
                          "type": "string",
                          "nullable": true
                        },
                        "expires_at": {
                          "type": "string",
                          "format": "date-time"
                        }
                      }
                    }
                  }
                }
              }
            }
          }
        }
      }
    },
    "/api/notas/pdf/exportacoes/{id}/arquivo": {
      "get": {
        "tags": ["PDFs"],
        "summary": "Baixa o ZIP de PDFs e remove o arquivo temporário após a transferência",
        "description": "Resultados PARTIAL incluem falhas.json. Pacotes não baixados também expiram pelo prazo configurado.",
        "parameters": [
          {
            "name": "id",
            "in": "path",
            "required": true,
            "schema": {
              "type": "string",
              "format": "uuid"
            }
          },
          {
            "name": "empresaId",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string",
              "format": "uuid"
            },
            "description": "Empresa cadastrada. Informe empresaId ou o CNPJ cadastrado para acessar suas notas."
          },
          {
            "name": "cnpj",
            "in": "query",
            "required": false,
            "schema": {
              "type": "string"
            }
          }
        ],
        "responses": {
          "200": {
            "description": "ZIP com os PDFs",
            "content": {
              "application/zip": {
                "schema": {
                  "type": "string",
                  "format": "binary"
                }
              }
            }
          },
          "409": {
            "description": "Pacote ainda não disponível ou em transferência"
          },
          "410": {
            "description": "Pacote expirado"
          }
        }
      }
    }
  },
  "components": {
    "requestBodies": {
      "CertificateUpload": {
        "required": true,
        "content": {
          "multipart/form-data": {
            "schema": {
              "type": "object",
              "required": ["arquivo", "senha"],
              "additionalProperties": false,
              "properties": {
                "arquivo": {
                  "type": "string",
                  "format": "binary",
                  "description": "Certificado A1 .pfx ou .p12 de até 10 MB"
                },
                "senha": {
                  "type": "string",
                  "format": "password",
                  "maxLength": 1000
                }
              }
            }
          }
        }
      }
    },
    "schemas": {
      "CertificateMetadata": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "arquivo": { "type": "string" },
          "titular": { "type": "string" },
          "validade": { "type": "string", "format": "date-time" },
          "fingerprint": { "type": "string" },
          "updated_at": { "type": "string", "format": "date-time" }
        }
      },
      "PdfExport": {
        "type": "object",
        "properties": {
          "id": { "type": "string", "format": "uuid" },
          "empresa_id": { "type": "string", "format": "uuid" },
          "ambiente": { "type": "string", "enum": ["homologacao", "producao"] },
          "competencia": { "type": "string", "nullable": true },
          "status": {
            "type": "string",
            "enum": [
              "QUEUED",
              "PROCESSING",
              "COMPLETED",
              "PARTIAL",
              "FAILED",
              "EXPIRED"
            ]
          },
          "total": { "type": "integer" },
          "processadas": { "type": "integer" },
          "falhas": { "type": "integer" },
          "erro": { "type": "string", "nullable": true },
          "created_at": { "type": "string", "format": "date-time" },
          "expires_at": { "type": "string", "format": "date-time" }
        }
      }
    },
    "securitySchemes": {
      "BearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "description": "Token de integração configurado em API_TOKEN. Uma variável vazia desativa apenas o acesso por token; as rotas continuam protegidas."
      },
      "ApiKeyAuth": {
        "type": "apiKey",
        "in": "header",
        "name": "x-api-key",
        "description": "Forma alternativa de enviar o token configurado em API_TOKEN."
      },
      "CookieAuth": {
        "type": "apiKey",
        "in": "cookie",
        "name": "nfse_session",
        "description": "Sessão do administrador criada em POST /auth/login. Alterações por cookie em /api exigem também X-CSRF-Token, retornado no login ou em GET /auth/session. Reiniciar o servidor exige novo login."
      }
    },
    "responses": {
      "AdminSession": {
        "description": "Sessão válida. Resposta não armazenável em cache.",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean", "example": true },
                "csrfToken": { "type": "string" },
                "expiresAt": {
                  "type": "integer",
                  "format": "int64",
                  "description": "Expiração absoluta em milissegundos Unix."
                }
              }
            }
          }
        }
      },
      "CertificateSaved": {
        "description": "Certificado validado e salvo, sem retornar a senha ou o conteúdo do arquivo",
        "content": {
          "application/json": {
            "schema": {
              "type": "object",
              "properties": {
                "success": { "type": "boolean" },
                "data": { "$ref": "#/components/schemas/CertificateMetadata" }
              }
            }
          }
        }
      },
      "Unauthorized": {
        "description": "Não autorizado: sessão ou token ausente, inválido ou expirado",
        "content": {
          "application/json": {
            "example": {
              "success": false,
              "error": "Não autorizado. Entre no painel ou forneça um API Token válido."
            }
          }
        }
      },
      "TooManyRequests": {
        "description": "Limite de requisições excedido (Rate Limit)",
        "content": {
          "application/json": {
            "example": {
              "success": false,
              "error": "Muitas requisições recebidas. Limite de taxa excedido. Tente novamente mais tarde."
            }
          }
        }
      }
    }
  }
}
