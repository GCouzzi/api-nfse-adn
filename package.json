{
  "name": "api-nfse-adn",
  "version": "1.0.0",
  "description": "API de Integração com ADN NFS-e Nacional via Procuração Eletrônica (Padrão 1)",
  "main": "src/server.ts",
  "scripts": {
    "start": "bun run src/server.ts",
    "dev": "bun --watch src/server.ts",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "build": "bun build src/server.ts --outdir ./dist --target bun",
    "build:exe": "bun build --compile --minify src/server.ts --outfile nfse-api.exe",
    "build:linux": "bun build --compile --minify --target=bun-linux-x64 src/server.ts --outfile nfse-api-linux"
  },
  "keywords": [
    "nfse",
    "adn",
    "nsu",
    "sped",
    "mtls",
    "bun"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@notaas/danfse-viewer": "1.0.10",
    "@types/pg": "^8.23.1",
    "adm-zip": "^0.5.16",
    "axios": "^1.7.7",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.21.0",
    "express-rate-limit": "^8.7.0",
    "fast-xml-parser": "^4.5.0",
    "multer": "2.4.0",
    "node-forge": "1.3.2",
    "pg": "^8.23.0",
    "puppeteer-core": "24.37.2",
    "yazl": "3.3.1"
  },
  "devDependencies": {
    "@electric-sql/pglite": "0.3.14",
    "@types/adm-zip": "^0.5.7",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/multer": "2.3.0",
    "@types/node": "^22.7.4",
    "@types/node-forge": "1.3.11",
    "@types/yazl": "3.3.0",
    "bun-types": "^1.4.2",
    "prettier": "3.4.2",
    "typescript": "5.9.3"
  }
}
