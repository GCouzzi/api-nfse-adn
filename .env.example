# Porta do servidor
PORT=3000

# ==============================================================================
# Autenticação e Segurança da API
# ==============================================================================
# Token/Chave secreta para autorizar requisições às rotas /api/*
# O cliente deve enviar via header 'Authorization: Bearer <API_TOKEN>' ou 'x-api-key: <API_TOKEN>'
# 
# FORMATO RECOMENDADO:
# - Chave de alta entropia com no mínimo 32 bytes (64 caracteres hexadecimais ou alfanuméricos aleatórios).
#
# COMO GERAR EM DIFERENTES SISTEMAS OPERACIONAIS:
# - Linux / macOS (via OpenSSL):
#     openssl rand -hex 32
#
# - Windows (PowerShell):
#     [Convert]::ToHexString([Security.Cryptography.RandomNumberGenerator]::GetBytes(32)).ToLower()
#
# - Qualquer sistema com Bun ou Node.js instalado:
#     bun -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
#
# Se deixado em branco, a API roda em modo aberto (apenas para desenvolvimento local).
API_TOKEN=substitua_pelo_token_gerado_com_os_comandos_acima

# ==============================================================================
# Rate Limiting (Inbound - Proteção da sua VPS contra ataques/abuso)
# ==============================================================================
# Janela de tempo em milissegundos (60000 = 1 minuto)
RATE_LIMIT_WINDOW_MS=60000
# Quantidade máxima de requisições por IP dentro da janela
RATE_LIMIT_MAX=100

# ==============================================================================
# Throttling ADN (Outbound - Proteção contra bloqueio de IP/WAF pela Receita Federal)
# ==============================================================================
# Intervalo em milissegundos entre lotes sucessivos de consulta ao ADN (recomendado: 500ms a 1000ms)
ADN_REQUEST_DELAY_MS=500
ADN_MAX_RETRIES=3

# ==============================================================================
# Seleção do Banco de Dados ('postgres' ou 'sqlite')
# ==============================================================================
DB_CLIENT=postgres

# Configuração do PostgreSQL (usado quando DB_CLIENT=postgres)
DATABASE_URL=postgresql://postgres:postgres@postgres:5432/nfse_db
PG_POOL_SIZE=10

# Caminho do banco SQLite (usado quando DB_CLIENT=sqlite)
DB_PATH=./data/nfse.db

# ==============================================================================
# Ambiente do ADN e Certificado Digital A1
# ==============================================================================
# 'homologacao' (testes restritos) ou 'producao' (ambiente oficial nacional)
ADN_ENV=producao
ADN_BASE_URL_HOMOLOGACAO=https://adn.producaorestrita.nfse.gov.br
ADN_BASE_URL_PRODUCAO=https://adn.nfse.gov.br

# Certificado Digital ICP-Brasil A1 (e-CNPJ com procuração eletrônica da Software House)
# 
# OPÇÃO 1 (Recomendada para VPS - Docker Secrets):
# Crie a pasta 'certs' manualmente na VPS ('mkdir -p certs') e copie seu arquivo para 'certs/certificado.pfx'.
# O Docker Compose irá montá-lo em /run/secrets/cert_pfx. Defina apenas a senha abaixo:
CERT_PASSWORD=sua_senha_do_certificado

# OPÇÃO 2 (Alternativa para PaaS como Easypanel / Render):
# Converta o certificado .pfx para Base64 e cole aqui:
# - Linux: base64 -w 0 certificado.pfx
# - PowerShell: [Convert]::ToBase64String([IO.File]::ReadAllBytes("certificado.pfx"))
# CERT_BASE64=

# Modo Mock para testes locais sem certificado físico (mude para 'false' em produção)
ENABLE_MOCK=false
